
<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest
    Version="7.0"
    ExtensionBundleId="com.safeframe.ai"
    ExtensionBundleVersion="1.0.0"
    ExtensionBundleName="SafeFrame AI">

    <ExtensionList>
        <Extension
            Id="com.safeframe.ai.panel"
            Version="1.0.0"/>
    </ExtensionList>

    <ExecutionEnvironment>
        <HostList>
            <Host
                Name="AEFT"
                Version="[24.0,99.9]"/>
        </HostList>

        <LocaleList>
            <Locale Code="All"/>
        </LocaleList>

        <RequiredRuntimeList>
            <RequiredRuntime
                Name="CSXS"
                Version="11.0"/>
        </RequiredRuntimeList>
    </ExecutionEnvironment>

    <DispatchInfoList>
        <Extension Id="com.safeframe.ai.panel">

            <DispatchInfo>
                <Resources>
                    <MainPath>./index.html</MainPath>
                    <ScriptPath>./jsx/host.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                    </CEFCommandLine>
                </Resources>

                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>

                <UI>
                    <Type>Panel</Type>
                    <Menu>SafeFrame AI</Menu>
                    <Geometry>
                        <Size>
                            <Width>360</Width>
                            <Height>650</Height>
                        </Size>
                        <MinSize>
                            <Width>300</Width>
                            <Height>450</Height>
                        </MinSize>
                    </Geometry>
                </UI>
            </DispatchInfo>

        </Extension>
    </DispatchInfoList>

</ExtensionManifest>
